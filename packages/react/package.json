    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "tsup",
    "publish:beta": "npm publish --tag beta",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {},
  "dependencies": {
    "@guideframe/core": "0.2.0-beta.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dinil-Thilakarathne/guide-frame.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Dinil-Thilakarathne/guide-frame#readme",
